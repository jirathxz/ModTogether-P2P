# =====================================================================
# ModTogether - Comprehensive .gitignore
# Prevents leak of build outputs, credentials, logs, and temp files
# =====================================================================

# ---------------------------------------------------------------------
# 1. Security & Personal Credentials (NEVER COMMIT)
# ---------------------------------------------------------------------
*.pfx
*.p12
*.cer
*.crt
*.pem
*.key
*.snk
*.asc
*.env
*.env.*
appsettings*.Development.json
appsettings*.Local.json
*.userossc

# ---------------------------------------------------------------------
# 2. Build Outputs & Compiled Binaries
# ---------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ist/
[Pp]ackages/
packages/
[Bb]uild/
[Pp]ublish/
*_wpftmp.csproj

# ---------------------------------------------------------------------
# 3. IDE, Editor & Tool Settings
# ---------------------------------------------------------------------
.vs/
.vscode/
.idea/
.agents/
.gemini/
*.user
*.suo
*.userprefs
*.sln.docstates
*.DotSettings.user

# ---------------------------------------------------------------------
# 4. Logs, Scratch Files & Temporary Dumps
# ---------------------------------------------------------------------
*.log
*.tmp
*.temp
_legacy/
_info/
ZipTest/
*.bak
*.swp
*.diff
out.log
visual_tree.txt
temp_manager.diff
test.cs
screenshot.png
plugin_resolve_error.log
plugin_types_debug.log
error.log

# ---------------------------------------------------------------------
# 5. Virtual Environments & Legacy Temp Assets
# ---------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------
# 6. App Runtime Data, Mod Presets & User Files
# ---------------------------------------------------------------------
GameMods/
.recycle_mods/
.stash/
presets/
sessions/
mod_owners.json
installed_mods.json
updater.bat
sign_executables.ps1