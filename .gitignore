# Ignore everything by default
*

# Whitelist essential root files
!*.sln
!*.md
!*.bat
!.gitignore

# Whitelist main program source code & plugins (extensions)
!ModTogether.API/
!ModTogetherUniversal/
!ModTogether.Extensions.MHW/

# Unignore everything inside whitelisted directories
!ModTogether.API/**
!ModTogetherUniversal/**
!ModTogether.Extensions.MHW/**

# Explicitly ignore build outputs, caches, and temp files
bin/
obj/
dist/
build/
*.user
*.suo
.vs/
.vscode/
.idea/
GameMods/
.recycle_mods/
installed_mods.json
*.log
*.tmp