# =====================================================================
# ModTogether - Comprehensive .gitignore
# Prevents leak of build outputs, credentials, logs, and temp files
# =====================================================================

# ---------------------------------------------------------------------
# 1. Security & Personal Credentials (NEVER COMMIT)
# ---------------------------------------------------------------------
*.pfx
*.p12
*.cer
*.crt
*.pem
*.key
*.snk
*.asc
*.env
*.env.*
appsettings*.Development.json
appsettings*.Local.json
*.userossc

# ---------------------------------------------------------------------
# 2. Build Outputs & Compiled Binaries
# ---------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ist/
dist/
[Pp]ackages/
packages/
[Bb]uild/
[Pp]ublish/
*_wpftmp.csproj
*.nupkg

# ---------------------------------------------------------------------
# 3. IDE, Editor & Tool Settings
# ---------------------------------------------------------------------
.vs/
.vscode/
.idea/
.agents/
.gemini/
*.user
*.suo
*.userprefs
*.sln.docstates
*.DotSettings.user
*.VisualState.xml

# ---------------------------------------------------------------------
# 4. OS Specific Files
# ---------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# ---------------------------------------------------------------------
# 5. Logs, Scratch Files & Temporary Dumps
# ---------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.diff
out.log
visual_tree.txt
temp_manager.diff
test.cs
screenshot.png
plugin_resolve_error.log
plugin_types_debug.log
error.log

# ---------------------------------------------------------------------
# 6. Rust & Python Leftovers / Virtual Environments
# ---------------------------------------------------------------------
target/
Cargo.lock
.cargo/
.venv/
venv/
ENV/
__pycache__/
*.pyc
_legacy/

# ---------------------------------------------------------------------
# 7. App Runtime Data, Mod Presets & User Files
# ---------------------------------------------------------------------
GameMods/
.recycle_mods/
.stash/
_info/
ZipTest/
presets/
sessions/
mod_owners.json
installed_mods.json
updater.bat
sign_executables.ps1