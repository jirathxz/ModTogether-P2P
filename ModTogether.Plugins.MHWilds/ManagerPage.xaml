<Page x:Class="ModTogether.Plugins.MHWilds.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="ManagerPage">

    <Page.Resources>
        <ContextMenu x:Key="ModLibraryContextMenu">
            <MenuItem Header="Move Priority Up (Load First)" Click="MenuMoveUp_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowUp24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Move Priority Down (Load Later)" Click="MenuMoveDown_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowDown24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Open Location" Click="MenuOpenLocation_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Delete Mod File" Click="MenuDeleteMod_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" Foreground="Red" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Page.Resources>

    <Grid Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <ui:Card Grid.Row="0" Margin="16,12,16,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Status -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Games24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="MH Wilds Mod Manager" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="TxtStatus" Text="Loading mods..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="28,2,0,0" />
                </StackPanel>

                <!-- Action Toolbar -->
                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnLaunchGame" Content="Launch Game" Icon="{ui:SymbolIcon Play24}" Click="BtnLaunchGame_Click" Appearance="Success" Margin="0,0,8,0" FontWeight="SemiBold" />
                    <ui:Button x:Name="BtnImportMod" Content="Import Mod" Icon="{ui:SymbolIcon ArrowDownload24}" Click="BtnImportMod_Click" Appearance="Primary" Margin="0,0,8,0" />
                    <ui:Button x:Name="BtnRefresh" Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Click="BtnRefresh_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="BtnOpenModsFolder" Content="Mods Folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="BtnOpenModsFolder_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="BtnScanConflicts" Content="Scan Conflicts" Icon="{ui:SymbolIcon Warning24}" Click="BtnScanConflicts_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="BtnBackup" Content="Backup" Icon="{ui:SymbolIcon Save24}" Click="BtnBackup_Click" Margin="0,0,4,0" />
                    <ui:Button x:Name="BtnRestore" Content="Restore" Icon="{ui:SymbolIcon ArrowReset24}" Click="BtnRestore_Click" Margin="0,0,4,0" />
                    <ui:Button x:Name="BtnUninstallAll" Content="Uninstall All" Icon="{ui:SymbolIcon DismissCircle24}" Click="BtnUninstallAll_Click" Appearance="Danger" />
                </WrapPanel>
            </Grid>
        </ui:Card>

        <!-- Main Content: 3 Column Layout -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" /> <!-- Library -->
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" />                 <!-- Detail (Cover + Desc) -->
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.5*" MinWidth="300" /><!-- Sub-Mods Panel -->
            </Grid.ColumnDefinitions>

            <!-- ============================== -->
            <!-- LEFT COLUMN: Mod Library List  -->
            <!-- ============================== -->
            <ui:Card Grid.Column="0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- List Header & Count -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Library24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Mod Library" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtModCount" Text="0/0 installed" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Search and Filter Bar -->
                    <Grid Grid.Row="1" Margin="10,10,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="105" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtSearch" Grid.Column="0" PlaceholderText="Search mods..." TextChanged="TxtSearch_TextChanged" Margin="0,0,6,0" Icon="{ui:SymbolIcon Search24}" />
                        <ComboBox x:Name="CmbFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="CmbFilter_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="All Mods" />
                            <ComboBoxItem Content="Installed" />
                            <ComboBoxItem Content="Uninstalled" />
                        </ComboBox>
                    </Grid>

                    <!-- List of Mods (Text Only, No Image) -->
                    <ListView x:Name="ListMods" Grid.Row="2"
                              Background="Transparent" BorderThickness="0"
                              SelectionMode="Single" AlternationCount="2"
                              SelectionChanged="ListMods_SelectionChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Padding="6,4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="8,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ContextMenu" Value="{StaticResource ModLibraryContextMenu}" />
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Indicator Bar -->
                                    <Border Grid.Column="0" Width="3" HorizontalAlignment="Left" CornerRadius="2" Margin="0,1,6,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Mod Name + Conflict + Author -->
                                    <StackPanel Grid.Column="1" Margin="4,0,6,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Warning24" Foreground="Orange" Visibility="{Binding ConflictVisibility}" ToolTip="{Binding ConflictWarningText}" Margin="0,0,4,0" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Filename}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Author}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Author}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Priority Badge -->
                                    <Border Grid.Column="2" CornerRadius="3" Padding="4,1" VerticalAlignment="Center" Margin="0,0,4,0" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PriorityText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding PriorityText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    </Border>

                                    <!-- Version Badge -->
                                    <Border Grid.Column="3" CornerRadius="3" Padding="5,2" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Version}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Version}" Value="">
                                                            <Setter Property="Text" Value="—" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Loading Ring -->
                    <ui:ProgressRing x:Name="LoadingRing" Grid.Row="2" Visibility="Collapsed" IsIndeterminate="True" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </ui:Card>

            <!-- ============================== -->
            <!-- MIDDLE COLUMN: Mod Detail View -->
            <!-- ============================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hero Preview Banner & Quick Action Card -->
                <ui:Card Grid.Row="0" Padding="0" Margin="0,0,0,10" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Preview Hero Image Container -->
                        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4,4,0,0" ClipToBounds="True">
                            <Grid>
                                <!-- Preview Image (UniformToFill) -->
                                <Image x:Name="ImgPreview" Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                
                                <!-- Dark Overlay Gradient for Readability -->
                                <Border VerticalAlignment="Bottom" Height="80">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.0" />
                                            <GradientStop Color="#DD000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Title, Author, Category on top of Image Overlay -->
                                <StackPanel VerticalAlignment="Bottom" Margin="16,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock x:Name="LblModTitle" Text="Select a mod" FontWeight="Bold" FontSize="20" Foreground="White" VerticalAlignment="Center" />
                                        <Border x:Name="BadgeVersion" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="#99000000" Visibility="Collapsed">
                                            <TextBlock x:Name="LblModVersion" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#E0E0E0" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="LblModAuthor" Text="" FontSize="12" Foreground="#D0D0D0" Margin="0,0,10,0" />
                                        <Border x:Name="BadgeCategory" Background="{DynamicResource SystemAccentColorPrimaryBrush}" CornerRadius="4" Padding="8,2" Visibility="Collapsed">
                                            <TextBlock x:Name="TxtCategory" Text="" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Mod Action Bar -->
                        <Border Grid.Row="1" Padding="14,10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Action Buttons: Install, Uninstall, Delete -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:Button x:Name="BtnInstall" Content="Install Mod" Icon="{ui:SymbolIcon CheckmarkCircle24}" Click="BtnInstall_Click" Appearance="Success" Margin="0,0,8,0" Padding="16,6" FontWeight="SemiBold" />
                                    <ui:Button x:Name="BtnUninstall" Content="Uninstall Mod" Icon="{ui:SymbolIcon DismissCircle24}" Click="BtnUninstall_Click" Appearance="Secondary" Margin="0,0,8,0" Padding="14,6" />
                                    <ui:Button x:Name="BtnDelete" Content="Delete" Icon="{ui:SymbolIcon Delete24}" Click="BtnDelete_Click" Appearance="Danger" Padding="12,6" />
                                </StackPanel>

                                <!-- Helper Note / Status -->
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Right-click mod item in library for priority menu" />
                            </Grid>
                        </Border>
                    </Grid>
                </ui:Card>

                <!-- Description Card -->
                <ui:Card Grid.Row="1" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Description" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10" />
                        
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LblModDesc" Text="No description available." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="22" />
                        </ScrollViewer>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- ============================== -->
            <!-- RIGHT COLUMN: Sub-mods Panel   -->
            <!-- ============================== -->
            <ui:Card Grid.Column="4" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Mod Items &amp; Parts" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Sub-mods List as Image Cards -->
                    <ListView x:Name="ListSubMods" Grid.Row="1"
                              Background="Transparent" BorderThickness="0" Padding="8,4"
                              SelectionChanged="ListSubMods_SelectionChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        
                        <!-- Hide ListSubMods header if empty -->
                        <ListView.Style>
                            <Style TargetType="ListView">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- Sub-mod Image Card Layout -->
                                <ui:Card Padding="0" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /> <!-- Sub-mod Full Image -->
                                            <RowDefinition Height="Auto" /> <!-- Sub-mod Details & Action -->
                                        </Grid.RowDefinitions>

                                        <!-- Sub-mod Image (Uniform) -->
                                        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4,4,0,0" ClipToBounds="True">
                                            <!-- Give it a MaxHeight so it doesn't take up too much vertical space, but keeps Aspect Ratio -->
                                            <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" MaxHeight="220" Margin="0,0,0,1" />
                                        </Border>

                                        <!-- Sub-mod Status Bar & Info -->
                                        <Grid Grid.Row="1" Margin="12,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Dot -->
                                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- Display Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />

                                            <!-- Action Button -->
                                            <ui:Button Grid.Column="2" Click="BtnToggleSubMod_Click" MinWidth="85" Margin="8,0,0,0">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Content" Value="Install" />
                                                        <Setter Property="Appearance" Value="Primary" />
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Content" Value="Uninstall" />
                                                                <Setter Property="Appearance" Value="Danger" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Content" Value="Wait..." />
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                        </Grid>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Message when no items -->
                    <TextBlock Grid.Row="1" Text="No selectable items or sub-mods for this mod." FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=ListSubMods}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
