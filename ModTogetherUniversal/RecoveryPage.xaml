<Page x:Class="ModTogetherUniversal.RecoveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Title="RecoveryPage">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== -->
        <!-- TOP TOOLBAR: Global Actions    -->
        <!-- ============================== -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="14,10" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Page Header Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="LblTitle" Text="Recycled Mods Library (.recycle_mods)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Batch Actions (Center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnRestoreChecked" Content="Restore Checked" Icon="{ui:SymbolIcon ArrowUndo24}" Appearance="Primary" Click="BtnRestoreChecked_Click" Margin="0,0,8,0" Padding="12,5" FontSize="12" />
                    <ui:Button x:Name="BtnDeleteChecked" Content="Delete Checked Permanently" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="BtnDeleteChecked_Click" Margin="0,0,12,0" Padding="12,5" FontSize="12" />
                </StackPanel>

                <!-- Selection Helpers (Right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnCheckAll" Content="Check All" Icon="{ui:SymbolIcon Checkmark24}" Click="BtnCheckAll_Click" Margin="0,0,6,0" Padding="8,4" FontSize="11" />
                    <ui:Button x:Name="BtnUncheckAll" Content="Uncheck All" Icon="{ui:SymbolIcon Dismiss24}" Click="BtnUncheckAll_Click" Padding="8,4" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== -->
        <!-- MAIN WORKSPACE: Master-Detail   -->
        <!-- ============================== -->
        <Grid Grid.Row="1" Margin="14,14,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="400" /> <!-- Recycled Mods List (Left) -->
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="300" />    <!-- Inspector & Options (Right) -->
            </Grid.ColumnDefinitions>

            <!-- ============================== -->
            <!-- LEFT PANEL: Recycled Mods List -->
            <!-- ============================== -->
            <ui:Card Grid.Column="0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Bar Header -->
                    <Border Grid.Row="0" Padding="10,8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <ui:TextBox x:Name="TxtSearch" PlaceholderText="Search recycled mods..." TextChanged="TxtSearch_TextChanged" Icon="{ui:SymbolIcon Search24}" MinHeight="32" FontSize="12" />
                    </Border>

                    <!-- Recycled Mods ListView -->
                    <ListView Grid.Row="1" x:Name="ListMods" 
                              SelectionChanged="ListMods_SelectionChanged" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Padding="6,4">
                        <ListView.Resources>
                            <!-- Custom Dark Header Style -->
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="8,8" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="36">
                                    <GridViewColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="✓" FontWeight="Bold" FontSize="11" ToolTip="Check for Batch Actions" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.HeaderTemplate>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="220" Header="Mod Name">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}" ToolTip="{Binding Filename}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="75" Header="Size">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Size}" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}" FontSize="11" Opacity="0.8" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="110" Header="Date Modified">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DateModified}" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}" FontSize="11" Opacity="0.8" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </ui:Card>

            <!-- ============================== -->
            <!-- RIGHT PANEL: Inspector Panel   -->
            <!-- ============================== -->
            <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Mod Inspector" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock x:Name="LblSelectedModInfo" Text="Select a mod from the list to inspect." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Contextual Item Actions -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <ui:Button x:Name="BtnRestore" Click="BtnRestore_Click" Content="Restore Mod" Icon="{ui:SymbolIcon ArrowUndo24}" Appearance="Primary" HorizontalAlignment="Stretch" IsEnabled="False" Margin="0,0,0,8" MinHeight="36" FontSize="13" />
                        <ui:Button x:Name="BtnDelete" Click="BtnDelete_Click" Content="Delete Permanently" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" HorizontalAlignment="Stretch" IsEnabled="False" MinHeight="36" FontSize="13" />
                    </StackPanel>

                    <!-- Notice / Guidance Card -->
                    <Border Grid.Row="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" VerticalAlignment="Bottom">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,0,6,0" FontSize="16" />
                                <TextBlock Text="About Recycled Mods" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Mods moved to the recycle bin are safely preserved here. Restoring a mod will place it back into your active game directory. Permanent deletion cannot be undone." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" LineHeight="16" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
