<Page x:Class="ModTogetherUniversal.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="PluginsPage">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="Plugins" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="TxtDesc" Text="Manage and load plugins for different games." Foreground="Gray" Margin="0,0,0,24" />
            
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button x:Name="BtnOpenFolder" Content="Open Plugins Folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="BtnOpenFolder_Click" Margin="0,0,8,0" Appearance="Primary"/>
            </StackPanel>
        </StackPanel>

        <ui:ListView x:Name="ListExtensions" Grid.Row="1" SelectionMode="Single">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ui:Badge Appearance="Secondary" Content="{Binding Version}" Margin="0,0,8,0"/>
                                <ui:Badge Appearance="Success" Content="{Binding TargetGame}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</Page>

