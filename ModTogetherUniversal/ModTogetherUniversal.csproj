<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\logo\mhw-512.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);NU1902</NoWarn>

    <!-- Build Reproducibility -->
    <Deterministic>true</Deterministic>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- PE Assembly Metadata -->
    <Title>ModTogether Universal</Title>
    <Product>ModTogether Universal</Product>
    <Description>Real-time Peer-to-Peer Mod Synchronization Suite for PC Gaming</Description>
    <Company>ModTogether Community</Company>
    <Copyright>Copyright © 2026 ModTogether. Open Source Software under MIT License.</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>1.3.5.0</Version>
    <AssemblyVersion>1.3.5.0</AssemblyVersion>
    <FileVersion>1.3.5.0</FileVersion>
    <InformationalVersion>1.3.5.0</InformationalVersion>
    <RepositoryUrl>https://github.com/jirathxz/ModTogether-P2P</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jirathxz/ModTogether-P2P</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.4" />
    <PackageReference Include="SharpCompress" Version="0.38.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Resource Include="Assets\**\*" />
    <Content Include="Plugins\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\logo\mhw-512.ico" Link="logo\mhw-512.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModTogether.API\ModTogether.API.csproj" />
  </ItemGroup>

</Project>
