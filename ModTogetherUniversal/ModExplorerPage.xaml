<Page x:Class="ModTogetherUniversal.ModExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:ModTogetherUniversal"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="900"
      Title="ModExplorerPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <ContextMenu x:Key="ModItemContextMenu">
            <MenuItem Header="Open Location" Click="MenuItem_OpenLocation_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Backup Mod" Click="MenuItem_Backup_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{Binding DataContext.MenuDeleteText, RelativeSource={RelativeSource AncestorType=Page}}" Click="MenuItem_Delete_Click">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" Foreground="Red" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitle" Text="Mod Explorer" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="TxtDesc" Text="Generic mod manager. Select a target path and choose how mods should be installed." Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Configuration Section -->
        <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Mod Folder Path (from Settings, read-only) -->
                <TextBlock x:Name="TxtModFolderLabel" Grid.Row="0" Grid.Column="0" Text="Mod Install Folder:" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtModFolderValue" Grid.Row="0" Grid.Column="1" Text="Not configured — please set in Settings" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" />

                <!-- Install Type -->
                <TextBlock x:Name="TxtInstallTypeLabel" Grid.Row="2" Grid.Column="0" Text="Install Type:" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbInstallType" SelectedIndex="0" MaxWidth="300" HorizontalAlignment="Left">
                    <ComboBoxItem x:Name="CmbItemSingle" Content="Single File (Copy files directly)" />
                    <ComboBoxItem x:Name="CmbItemExtract" Content="Extract File (Extract archive into Target Path)" />
                </ComboBox>
            </Grid>
        </ui:Card>


        <!-- Mods List Section -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                <ui:Button x:Name="BtnCheckAll" Content="Check All" Icon="{ui:SymbolIcon CheckmarkSquare24}" Click="BtnCheckAll_Click" Margin="0,0,8,4" />
                <ui:Button x:Name="BtnUncheckAll" Content="Uncheck All" Icon="{ui:SymbolIcon Square24}" Click="BtnUncheckAll_Click" Margin="0,0,8,4" />
                <ui:Button x:Name="BtnScanConflicts" Content="Scan Conflicts ⚔️" Icon="{ui:SymbolIcon Warning24}" Click="BtnScanConflicts_Click" Margin="0,0,8,4" />
                <ui:Button x:Name="BtnImportMod" Content="Import Mod" Icon="{ui:SymbolIcon ArrowDownload24}" Click="BtnImportMod_Click" Margin="0,0,8,4" />
                <ui:Button x:Name="BtnOpenModsFolder" Content="Open Mods Folder" Icon="{ui:SymbolIcon FolderOpen24}" Click="BtnOpenModsFolder_Click" Appearance="Primary" Margin="0,0,8,4" />
                <ui:Button x:Name="BtnRefreshMods" Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="BtnRefreshMods_Click" Margin="0,0,8,4" />
                <ui:Button x:Name="BtnBackupChecked" Content="Backup Checked" Icon="{ui:SymbolIcon Save24}" Click="BtnBackupChecked_Click" Margin="0,0,8,4" />
                <ui:Button x:Name="BtnDeleteChecked" Content="Delete Checked" Icon="{ui:SymbolIcon Delete24}" Click="BtnDeleteChecked_Click" Appearance="Danger" Margin="0,0,8,4" />
                <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="8,0,0,4" Foreground="Gray" />
            </WrapPanel>

            <ListView Grid.Row="1" x:Name="ListMods" SelectionMode="Single" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" AlternationCount="2">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                        <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ContextMenu" Value="{StaticResource ModItemContextMenu}" />
                        <Style.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#05FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="60">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.ColInstallText, RelativeSource={RelativeSource AncestorType=Page}}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="Mod_Checked" Unchecked="Mod_Unchecked" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="360">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.ColFilenameText, RelativeSource={RelativeSource AncestorType=Page}}" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Warning24" Foreground="Orange" Visibility="{Binding ConflictVisibility}" Margin="0,0,6,0" ToolTip="{Binding ConflictWarningText}" />
                                        <TextBlock Text="{Binding Filename}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding ConflictWarningText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="80" Header="Priority">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Priority}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="LightBlue" FontWeight="Bold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.ColSizeText, RelativeSource={RelativeSource AncestorType=Page}}" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Size}" VerticalAlignment="Center" Foreground="Gray" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="180">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DataContext.ColModifiedText, RelativeSource={RelativeSource AncestorType=Page}}" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateModified}" VerticalAlignment="Center" Foreground="Gray" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Page>
